# Copy to api/.env and fill in. Never commit the real .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas free tier works fine).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/modern-haven

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of sites allowed to call the API from a browser
# (the storefront now, the admin console later).
CORS_ORIGINS=http://localhost:4000

# Only used by `npm run create-admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
