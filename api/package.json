{
  "name": "modern-haven-api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the Modern Haven store (gadgets & clothing).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "create-admin": "node scripts/createAdmin.js",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.11",
    "morgan": "^1.12.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.3.2"
  }
}
